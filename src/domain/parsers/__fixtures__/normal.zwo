<workout_file>
  <author>Spinning Tutor tests</author>
  <name>Test Ladder</name>
  <description>Original fixture: warmup, steady, intervals, ramp, free ride, cooldown.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="300" PowerLow="0.4" PowerHigh="0.75" Cadence="90">
      <textevent timeoffset="0" message="Easy start"/>
      <textevent timeoffset="60" message="Second message"/>
    </Warmup>
    <SteadyState Duration="240.4" Power="0.8" Cadence="85"/>
    <IntervalsT Repeat="4" OnDuration="60" OffDuration="90" OnPower="1.1" OffPower="0.5" Cadence="100" CadenceResting="80"/>
    <Ramp Duration="180" PowerLow="0.6" PowerHigh="0.9"/>
    <FreeRide Duration="120"/>
    <Cooldown Duration="240" PowerLow="0.7" PowerHigh="0.4"/>
  </workout>
</workout_file>

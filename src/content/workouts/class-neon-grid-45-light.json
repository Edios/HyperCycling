{
  "id": "class-neon-grid-45-light",
  "name": "Class: Neon Grid Light 45",
  "description": "Eleven songs on a five-step resistance knob: intervals, rolling hills, a pyramid and a sprint finish, with long recoveries and no summit climb.",
  "localized": {
    "en": {
      "name": "Class: Neon Grid Light 45",
      "description": "Eleven songs on a five-step resistance knob: intervals, rolling hills, a pyramid and a sprint finish, with long recoveries and no summit climb.",
      "songHints": {
        "class-neon-grid-45-light-s1": "Easy electronic warm-up, about 5 min. Aim for about 90 BPM. Idea: Kavinsky – Nightcall (91).",
        "class-neon-grid-45-light-s2": "Four-on-the-floor groove for the first hill. Aim for about 128 BPM. Idea: Daft Punk – One More Time (123).",
        "class-neon-grid-45-light-s3": "Fast, driving song for 30/30 intervals. Aim for about 174 BPM. Idea: The Weeknd – Blinding Lights (171).",
        "class-neon-grid-45-light-s4": "Calm, spacious song to recover. Aim for about 89 BPM. Idea: Tycho – Awake (88).",
        "class-neon-grid-45-light-s5": "Anthemic mid-tempo song for rolling hills. Aim for about 128 BPM. Idea: Swedish House Mafia – Don’t You Worry Child (129).",
        "class-neon-grid-45-light-s6": "Calm, spacious song to recover. Aim for about 89 BPM. Idea: Chase & Status – Blind Faith, Loadstar Remix (87).",
        "class-neon-grid-45-light-s7": "Fast, driving song for the pyramid. Aim for about 174 BPM. Idea: Pendulum – Witchcraft (172-175).",
        "class-neon-grid-45-light-s8": "Pick your own calm electronic song, 85-95 BPM; nothing is pinned for this slot.",
        "class-neon-grid-45-light-s9": "Calm, spacious song to recover. Aim for about 89 BPM. Idea: Tycho – Awake (88).",
        "class-neon-grid-45-light-s10": "Fast, driving song for the sprints. Aim for about 174 BPM. Idea: Sub Focus – Tidal Wave (174).",
        "class-neon-grid-45-light-s11": "Quiet, beatless ambient piece; the last minute is silent. Aim for about 67 BPM. Idea: Brian Eno – An Ending (Ascent), no beat."
      }
    },
    "pl": {
      "name": "Zajęcia: Neon Grid Lekki 45",
      "description": "Jedenaście piosenek na pięciostopniowym pokrętle oporu: interwały, toczące się wzgórza, piramida i sprint na koniec, z długimi odpoczynkami i bez podjazdu na szczyt.",
      "songHints": {
        "class-neon-grid-45-light-s1": "Lekka elektronika na rozgrzewkę, ok. 5 min. Szukaj ok. 90 BPM. Pomysł: Kavinsky – Nightcall (91).",
        "class-neon-grid-45-light-s2": "Równy rytm na pierwsze wzniesienie. Szukaj ok. 128 BPM. Pomysł: Daft Punk – One More Time (123).",
        "class-neon-grid-45-light-s3": "Szybki, napędzający utwór na interwały 30/30. Szukaj ok. 174 BPM. Pomysł: The Weeknd – Blinding Lights (171).",
        "class-neon-grid-45-light-s4": "Spokojny, przestrzenny utwór na odpoczynek. Szukaj ok. 89 BPM. Pomysł: Tycho – Awake (88).",
        "class-neon-grid-45-light-s5": "Hymniczny utwór o średnim tempie na toczące się wzgórza. Szukaj ok. 128 BPM. Pomysł: Swedish House Mafia – Don’t You Worry Child (129).",
        "class-neon-grid-45-light-s6": "Spokojny, przestrzenny utwór na odpoczynek. Szukaj ok. 89 BPM. Pomysł: Chase & Status – Blind Faith, Loadstar Remix (87).",
        "class-neon-grid-45-light-s7": "Szybki, napędzający utwór na piramidę. Szukaj ok. 174 BPM. Pomysł: Pendulum – Witchcraft (172-175).",
        "class-neon-grid-45-light-s8": "Wybierz własny spokojny utwór elektroniczny, 85-95 BPM; ten slot nie ma przypiętego utworu.",
        "class-neon-grid-45-light-s9": "Spokojny, przestrzenny utwór na odpoczynek. Szukaj ok. 89 BPM. Pomysł: Tycho – Awake (88).",
        "class-neon-grid-45-light-s10": "Szybki, napędzający utwór na sprinty. Szukaj ok. 174 BPM. Pomysł: Sub Focus – Tidal Wave (174).",
        "class-neon-grid-45-light-s11": "Cichy ambient bez beatu; ostatnia minuta w ciszy. Szukaj ok. 67 BPM. Pomysł: Brian Eno – An Ending (Ascent), no beat."
      }
    }

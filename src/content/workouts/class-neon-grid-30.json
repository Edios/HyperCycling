{
  "id": "class-neon-grid-30",
  "name": "Class: Neon Grid 30",
  "description": "Seven songs on a five-step resistance knob: intervals, a summit climb with a long recovery after it, and a sprint finish.",
  "localized": {
    "en": {
      "name": "Class: Neon Grid 30",
      "description": "Seven songs on a five-step resistance knob: intervals, a summit climb with a long recovery after it, and a sprint finish.",
      "songHints": {
        "class-neon-grid-30-s1": "Easy electronic warm-up, about 5 min. Aim for about 90 BPM. Idea: Kavinsky – Nightcall (91).",
        "class-neon-grid-30-s2": "Fast, driving song for 30/30 intervals. Aim for about 174 BPM. Idea: The Weeknd – Blinding Lights (171).",
        "class-neon-grid-30-s3": "Calm, spacious song to recover. Aim for about 89 BPM. Idea: Tycho – Awake (88).",
        "class-neon-grid-30-s4": "Big uplifting song for the long summit climb. Aim for about 126 BPM. Idea: David Guetta & Sia – Titanium (126).",
        "class-neon-grid-30-s5": "Pick your own calm electronic song, 85-95 BPM; nothing is pinned for this slot.",
        "class-neon-grid-30-s6": "Fast, driving song for the sprints. Aim for about 174 BPM. Idea: Sub Focus – Tidal Wave (174).",
        "class-neon-grid-30-s7": "Quiet, beatless ambient piece; the last minute is silent. Aim for about 67 BPM. Idea: Brian Eno – An Ending (Ascent), no beat."
      }
    },
    "pl": {
      "name": "Zajęcia: Neon Grid 30",
      "description": "Siedem piosenek na pięciostopniowym pokrętle oporu: interwały, podjazd na szczyt z długim odpoczynkiem po nim i sprint na koniec.",
      "songHints": {
        "class-neon-grid-30-s1": "Lekka elektronika na rozgrzewkę, ok. 5 min. Szukaj ok. 90 BPM. Pomysł: Kavinsky – Nightcall (91).",
        "class-neon-grid-30-s2": "Szybki, napędzający utwór na interwały 30/30. Szukaj ok. 174 BPM. Pomysł: The Weeknd – Blinding Lights (171).",
        "class-neon-grid-30-s3": "Spokojny, przestrzenny utwór na odpoczynek. Szukaj ok. 89 BPM. Pomysł: Tycho – Awake (88).",
        "class-neon-grid-30-s4": "Podniosły utwór na długi podjazd na szczyt. Szukaj ok. 126 BPM. Pomysł: David Guetta & Sia – Titanium (126).",
        "class-neon-grid-30-s5": "Wybierz własny spokojny utwór elektroniczny, 85-95 BPM; ten slot nie ma przypiętego utworu.",
        "class-neon-grid-30-s6": "Szybki, napędzający utwór na sprinty. Szukaj ok. 174 BPM. Pomysł: Sub Focus – Tidal Wave (174).",
        "class-neon-grid-30-s7": "Cichy ambient bez beatu; ostatnia minuta w ciszy. Szukaj ok. 67 BPM. Pomysł: Brian Eno – An Ending (Ascent), no beat."
      }
    }
  },

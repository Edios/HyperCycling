{
  "name": "spinning-tutor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "cross-env VITE_STORAGE=http vite build --outDir dist/client --emptyOutDir",
    "build:e2e": "cross-env VITE_STORAGE=http VITE_E2E=1 vite build --outDir dist/e2e --emptyOutDir",
    "build:pages": "cross-env VITE_STORAGE=indexeddb VITE_BASE=/Spinning-Tutor/ vite build --outDir dist/pages --emptyOutDir",
    "build:pages:e2e": "cross-env VITE_STORAGE=indexeddb VITE_BASE=/Spinning-Tutor/ VITE_E2E=1 vite build --outDir dist/e2e-pages --emptyOutDir",
    "start": "tsx scripts/start.ts",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check src tests scripts .github *.ts *.js *.json *.md",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "docs:screenshots": "tsx scripts/docs-screenshots.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@fastify/static": "10.1.8",
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "idb": "8.0.4",
    "open": "11.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "27.0.1",
    "msw": "2.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "3.2.7"
  }
}

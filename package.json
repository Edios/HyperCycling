{
  "name": "spinning-tutor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "cross-env VITE_STORAGE=http vite build --outDir dist/client --emptyOutDir",
    "build:e2e": "cross-env VITE_STORAGE=http VITE_E2E=1 vite build --outDir dist/e2e --emptyOutDir",
    "build:pages": "cross-env VITE_STORAGE=indexeddb VITE_BASE=/ vite build --outDir dist/pages --emptyOutDir",
    "build:pages:e2e": "cross-env VITE_STORAGE=indexeddb VITE_BASE=/ VITE_E2E=1 vite build --outDir dist/e2e-pages --emptyOutDir",
    "start": "tsx scripts/start.ts",
    "test": "vitest run --coverage",
    "test:client": "vitest run --project client",
    "test:node": "vitest run --project node --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check src tests scripts .github *.ts *.js *.json *.md",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:music": "node scripts/check-experience-music.mjs",
    "docs:screenshots": "tsx scripts/docs-screenshots.ts",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "test:layout": "playwright test -c playwright.layout.config.ts",
    "layout:report": "tsx scripts/layout-report.ts",
    "changelog": "tsx scripts/changelog.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@fastify/static": "10.1.11",
    "better-sqlite3": "13.2.0",
    "fast-xml-parser": "5.12.1",
    "fastify": "5.12.8",
    "idb": "8.0.4",
    "open": "11.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "fit-file-parser": "6.2.10",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "msw": "3.0.7",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
